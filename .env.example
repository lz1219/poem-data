# 复制为 .env 后填写。.env 不进版本库。
# 本文件只放「键名与示例」，永远不要写真实口令。

# ── 服务 ──
PORT=5321

# ── PostgreSQL（只读账号优先）──
# 建议单独建一个只有 SELECT 权限的角色，不要用超级用户。
PGHOST=your-host
PGPORT=5432
PGDATABASE=jiangshan
PGUSER=readonly_user
PGPASSWORD=change-me
PGSSLMODE=prefer

# ── 录入后台 ──
# 不设置则 /admin 整体关闭。
ADMIN_TOKEN=change-me-too

# ── 缓存与限制 ──
CACHE_TTL=60
RATE_LIMIT=60
