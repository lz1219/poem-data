      "revision": 1,
      "paragraphId": 129692,
      "sourceSha256": "852f9fdca4f403a0597c19a5019ba3d33a67e2fc0276af19557b533bdd6432c1",
      "sourceText": "齊康公薨，無子，田氏遂並齊而有之。",
      "translation": "齐康公去世，没有儿子，田氏于是兼并齐国并占有其国。",
      "reviewStatus": "unreviewed",
      "aiLabel": "AI生成·未经人工审校",
      "basis": {
