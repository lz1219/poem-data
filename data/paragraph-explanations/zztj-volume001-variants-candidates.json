      "revision": 1,
      "paragraphId": 129658,
      "sourceSha256": "1d548239ca43c6785d3d44b89b8007865a6c33b2c578ed8f818da329c603bc2d",
      "sourceText": "楚〔敗鄭師〕，圍鄭。鄭人殺其相駟子陽。",
      "translation": "楚军打败郑军，包围郑国。郑国人杀死了国相驷子阳。",
      "reviewStatus": "unreviewed",
      "aiLabel": "AI生成·未经人工审校",
      "basis": {
