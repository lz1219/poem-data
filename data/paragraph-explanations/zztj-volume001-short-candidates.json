      "paragraphId": 129663,
      "sourceSha256": "9cca25affd44e5ad0d2453e7e50be4e41c8d3079d04d6ccf3d052c31dbc4deab",
      "sourceText": "鄭負黍叛，復歸韓。",
      "translation": "郑国的负黍叛乱，后来又归附韩国。",
      "reviewStatus": "unreviewed",
      "aiLabel": "AI生成·未经人工审校",
      "basis": {
        "kind": "source-text",
        "paragraphId": 129663
