      "revision": 1,
      "paragraphId": 129661,
      "sourceSha256": "1a3f52c5ce4669ff24504ba4073c90adb8ad3e5f0c2461618999e9b5ff127b12",
      "sourceText": "鄭駟子陽之黨弒繻公，而立其弟乙，是為康公。",
      "translation": "郑国驷子阳的党羽杀害郑繻公，拥立他的弟弟乙，是为郑康公。",
      "reviewStatus": "unreviewed",
      "aiLabel": "AI生成·未经人工审校",
      "basis": {
        "kind": "source-text",
        "paragraphId": 129661
      },
      "notes": []
    },
