      "revision": 1,
      "paragraphId": 129718,
      "sourceSha256": "fc9ef254d719cbd9b039b79ed72657e96d15ca81e1972c6c69b6565e000dd67f",
      "sourceText": "日有食之。",
      "translation": "发生了日食。",
      "reviewStatus": "unreviewed",
      "aiLabel": "AI生成·未经人工审校",
      "basis": {
        "kind": "source-text",
        "paragraphId": 129718
      },
      "notes": [
        {
          "quote": "食",
          "start": 2,
          "end": 3,
          "explanation": "日食，月球遮掩太阳的现象。",
          "attribution": "本站AI拟释",
          "basis": {
            "kind": "source-text",
            "paragraphId": 129718
          }
        }
      ]
    },
    {
      "id": "paragraph-129719-explanation",
      "revision": 1,
      "paragraphId": 129719,
      "sourceSha256": "69e4d07edb5da514baa39f16a4f1a91ee39c57b02d9d133c8bbf379c89109526",
      "sourceText": "王崩，弟扁立，是為顯王。",
      "translation": "周王去世，他的弟弟扁即位，是为周显王。",
      "reviewStatus": "unreviewed",
      "aiLabel": "AI生成·未经人工审校",
      "basis": {
        "kind": "source-text",
        "paragraphId": 129719
      },
