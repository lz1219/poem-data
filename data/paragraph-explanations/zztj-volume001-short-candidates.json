      "revision": 1,
      "paragraphId": 129693,
      "sourceSha256": "7877eb92e89fb4858681a58a1920321af8afcbbda590851fc988f5445c88874e",
      "sourceText": "狄敗魏師于澮。",
      "translation": "狄人在浍地打败魏军。",
      "reviewStatus": "unreviewed",
      "aiLabel": "AI生成·未经人工审校",
      "basis": {
        "kind": "source-text",
        "paragraphId": 129693
      },
      "notes": []
    },
    {
      "id": "paragraph-129694-explanation",
      "revision": 1,
      "paragraphId": 129694,
      "sourceSha256": "ce2409daacb496f5e72c0e4c4cdf4182e403d6a8ef5b1e0a3c1d6fbeeb848084",
      "sourceText": "魏、韓、趙伐齊，至靈丘。",
      "translation": "魏、韩、赵三国攻打齐国，到达灵丘。",
      "reviewStatus": "unreviewed",
      "aiLabel": "AI生成·未经人工审校",
      "basis": {
        "kind": "source-text",
        "paragraphId": 129694
      },
      "notes": []
    },
    {
      "id": "paragraph-129695-explanation",
      "revision": 1,
      "paragraphId": 129695,
      "sourceSha256": "8abcfc25304a5a134b6f5b30b5831bd71c8ec21c7bf4a6023b777491be2edc2a",
      "sourceText": "晉孝公薨，子靖公俱酒立。",
      "translation": "晋孝公去世，他的儿子俱酒即位，是为晋靖公。",
      "reviewStatus": "unreviewed",
      "aiLabel": "AI生成·未经人工审校",
      "basis": {
        "kind": "source-text",
        "paragraphId": 129695
      },
      "notes": [
        {
          "quote": "薨",
          "start": 3,
          "end": 4,
          "explanation": "古代对诸侯等去世的称谓。",
          "attribution": "本站AI拟释",
          "basis": {
            "kind": "source-text",
            "paragraphId": 129695
          }
        }
      ]
    },
    {
      "id": "paragraph-129696-explanation",
      "revision": 1,
      "paragraphId": 129696,
      "sourceSha256": "a766998ead47b8c1f0f8eafb69a08facc0d066e871cbd80d557fea453454c065",
      "sourceText": "蜀伐楚，取茲方。",
      "translation": "蜀国攻打楚国，夺取兹方。",
      "reviewStatus": "unreviewed",
      "aiLabel": "AI生成·未经人工审校",
      "basis": {
        "kind": "source-text",
        "paragraphId": 129696
      },
      "notes": []
    },
    {
      "id": "paragraph-129698-explanation",
      "revision": 1,
      "paragraphId": 129698,
      "sourceSha256": "5fc2299302e090f0fbcd27d87a2a2d12057e1c782cf534882ac86891acd0402c",
      "sourceText": "韓文侯薨，子哀侯立。",
      "translation": "韩文侯去世，他的儿子韩哀侯即位。",
      "reviewStatus": "unreviewed",
      "aiLabel": "AI生成·未经人工审校",
      "basis": {
        "kind": "source-text",
        "paragraphId": 129698
      },
      "notes": [
        {
          "quote": "薨",
          "start": 3,
          "end": 4,
          "explanation": "古代对诸侯等去世的称谓。",
          "attribution": "本站AI拟释",
          "basis": {
            "kind": "source-text",
            "paragraphId": 129698
          }
        }
      ]
    },
    {
      "id": "paragraph-129699-explanation",
      "revision": 1,
      "paragraphId": 129699,
      "sourceSha256": "7569af600e5042d8a78a728dc841178c18ffffe5656359d74c07ae78925b1cbe",
      "sourceText": "王崩，子烈王喜立。",
      "translation": "周王去世，他的儿子喜即位，是为周烈王。",
      "reviewStatus": "unreviewed",
      "aiLabel": "AI生成·未经人工审校",
      "basis": {
        "kind": "source-text",
        "paragraphId": 129699
      },
      "notes": [
        {
          "quote": "崩",
          "start": 1,
          "end": 2,
          "explanation": "古代对君主去世的称谓；此处“王”指周王。",
          "attribution": "本站AI拟释",
          "basis": {
            "kind": "source-text",
            "paragraphId": 129699
          }
        }
      ]
    },
    {
      "id": "paragraph-129700-explanation",
      "revision": 1,
      "paragraphId": 129700,
      "sourceSha256": "53f086512e42083b26a933c406eeebf2c3077f1ab478b4b1a7ebdc709866cfda",
      "sourceText": "魏、韓、趙共廢晉靖公為家人而分其地。",
      "translation": "魏、韩、赵三国共同废黜晋靖公，让他成为平民，并瓜分了晋国的土地。",
      "reviewStatus": "unreviewed",
      "aiLabel": "AI生成·未经人工审校",
      "basis": {
        "kind": "source-text",
        "paragraphId": 129700
      },
      "notes": []
    },
    {
      "id": "paragraph-129701-explanation",
      "revision": 1,
      "paragraphId": 129701,
      "sourceSha256": "fc9ef254d719cbd9b039b79ed72657e96d15ca81e1972c6c69b6565e000dd67f",
      "sourceText": "日有食之。",
      "translation": "发生了日食。",
      "reviewStatus": "unreviewed",
      "aiLabel": "AI生成·未经人工审校",
      "basis": {
        "kind": "source-text",
        "paragraphId": 129701
      },
      "notes": [
        {
          "quote": "食",
          "start": 2,
          "end": 3,
          "explanation": "日食，月球遮掩太阳的现象。",
          "attribution": "本站AI拟释",
          "basis": {
            "kind": "source-text",
            "paragraphId": 129701
          }
        }
      ]
    },
    {
      "id": "paragraph-129702-explanation",
      "revision": 1,
      "paragraphId": 129702,
      "sourceSha256": "07ce0e21d1006420dec9c8b302ab3bc588f9ad568b90f41d71c633fe97188ce9",
      "sourceText": "韓滅鄭，因徒都之。",
      "translation": "韩国灭掉郑国，于是把国都迁到郑地。",
      "reviewStatus": "unreviewed",
      "aiLabel": "AI生成·未经人工审校",
      "basis": {
        "kind": "source-text",
        "paragraphId": 129702
      },
      "notes": []
    },
    {
      "id": "paragraph-129703-explanation",
      "revision": 1,
      "paragraphId": 129703,
      "sourceSha256": "77c07dab4bb516e7f0bdc6c1ad3a02077529ac28634f97aae8d0d5d98dfca9c5",
      "sourceText": "趙敬侯薨，子成侯種立。",
      "translation": "赵敬侯去世，他的儿子种即位，是为赵成侯。",
      "reviewStatus": "unreviewed",
      "aiLabel": "AI生成·未经人工审校",
      "basis": {
        "kind": "source-text",
        "paragraphId": 129703
      },
      "notes": [
        {
          "quote": "薨",
          "start": 3,
          "end": 4,
          "explanation": "古代对诸侯等去世的称谓。",
          "attribution": "本站AI拟释",
          "basis": {
            "kind": "source-text",
            "paragraphId": 129703
          }
        }
      ]
    },
    {
      "id": "paragraph-129705-explanation",
      "revision": 1,
      "paragraphId": 129705,
      "sourceSha256": "3f3eda5f2dc6cccaaa6472c46497ff1ee5f2e58c44032eab558ed79815c4e7a6",
      "sourceText": "燕敗齊師於林狐。",
      "translation": "燕国军队在林狐打败齐军。",
      "reviewStatus": "unreviewed",
      "aiLabel": "AI生成·未经人工审校",
      "basis": {
        "kind": "source-text",
        "paragraphId": 129705
      },
      "notes": []
    },
    {
      "id": "paragraph-129706-explanation",
      "revision": 1,
      "paragraphId": 129706,
      "sourceSha256": "dc179738df74767d93c661722db76ee9e8c7bf80fcc5a4635acffd64231c85b9",
      "sourceText": "魯伐齊，入陽關。",
      "translation": "鲁国攻打齐国，进入阳关。",
      "reviewStatus": "unreviewed",
      "aiLabel": "AI生成·未经人工审校",
      "basis": {
        "kind": "source-text",
        "paragraphId": 129706
      },
      "notes": []
    },
    {
      "id": "paragraph-129707-explanation",
      "revision": 1,
      "paragraphId": 129707,
      "sourceSha256": "e5928566ade26a728a8befbadd7b3a99312c3bb314b0e9ba101424eb86e09849",
      "sourceText": "魏伐齊，至博陵。",
      "translation": "魏国攻打齐国，到达博陵。",
      "reviewStatus": "unreviewed",
      "aiLabel": "AI生成·未经人工审校",
      "basis": {
        "kind": "source-text",
        "paragraphId": 129707
      },
      "notes": []
    },
    {
      "id": "paragraph-129708-explanation",
      "revision": 1,
      "paragraphId": 129708,
      "sourceSha256": "783cc164daf7da11f4267d367a6df04c72fe8b9e6e57b25b213f5f6664c29e60",
      "sourceText": "燕僖侯薨，子桓侯立。",
      "translation": "燕僖侯去世，他的儿子燕桓侯即位。",
      "reviewStatus": "unreviewed",
      "aiLabel": "AI生成·未经人工审校",
      "basis": {
        "kind": "source-text",
        "paragraphId": 129708
      },
      "notes": [
        {
          "quote": "薨",
          "start": 3,
          "end": 4,
          "explanation": "古代对诸侯等去世的称谓。",
          "attribution": "本站AI拟释",
          "basis": {
            "kind": "source-text",
            "paragraphId": 129708
          }
        }
      ]
    },
    {
      "id": "paragraph-129709-explanation",
      "revision": 1,
      "paragraphId": 129709,
      "sourceSha256": "1c686a86ef4569903c1c8d9879466c1d6b9aea17f1146e69aee2526f686fbcfa",
      "sourceText": "衛慎侯薨，子聲侯訓立。",
      "translation": "卫慎侯去世，他的儿子训即位，是为卫声侯。",
      "reviewStatus": "unreviewed",
      "aiLabel": "AI生成·未经人工审校",
      "basis": {
        "kind": "source-text",
        "paragraphId": 129709
      },
      "notes": [
        {
          "quote": "薨",
          "start": 3,
          "end": 4,
          "explanation": "古代对诸侯等去世的称谓。",
          "attribution": "本站AI拟释",
          "basis": {
            "kind": "source-text",
            "paragraphId": 129709
          }
        }
      ]
    },
    {
      "id": "paragraph-129710-explanation",
      "revision": 1,
      "paragraphId": 129710,
      "sourceSha256": "204a9a1c1e2d2044591a555475edd621a9657d7fa7239488060a8c2510a90c4f",
      "sourceText": "趙伐衛，取都鄙七十三。",
      "translation": "赵国攻打卫国，夺取了七十三处都邑。",
      "reviewStatus": "unreviewed",
      "aiLabel": "AI生成·未经人工审校",
      "basis": {
        "kind": "source-text",
        "paragraphId": 129710
      },
      "notes": []
    },
    {
      "id": "paragraph-129711-explanation",
      "revision": 1,
      "paragraphId": 129711,
      "sourceSha256": "5f55252d6220d6658826809f31c4c058a0cf1e4cab1ccfe02795228ae7d991df",
      "sourceText": "魏敗趙師于北藺。",
      "translation": "魏国军队在北蔺打败赵军。",
      "reviewStatus": "unreviewed",
      "aiLabel": "AI生成·未经人工审校",
      "basis": {
        "kind": "source-text",
        "paragraphId": 129711
      },
      "notes": []
    },
    {
      "id": "paragraph-129712-explanation",
      "revision": 1,
      "paragraphId": 129712,
      "sourceSha256": "173a8f816f0c03464bea447d16542207a64e92ab32eaf6e88d529ee9dbaecfb2",
      "sourceText": "魏伐楚，取魯陽。",
      "translation": "魏国攻打楚国，夺取鲁阳。",
      "reviewStatus": "unreviewed",
      "aiLabel": "AI生成·未经人工审校",
      "basis": {
        "kind": "source-text",
        "paragraphId": 129712
      },
      "notes": []
    },
    {
      "id": "paragraph-129714-explanation",
      "revision": 1,
      "paragraphId": 129714,
      "sourceSha256": "8d8a31ce22a60a1441ff6b505aae50f400ae4002e483a1265f740a1f6390d3d9",
      "sourceText": "趙伐齊，至鄄。",
      "translation": "赵国攻打齐国，到达鄄地。",
      "reviewStatus": "unreviewed",
      "aiLabel": "AI生成·未经人工审校",
      "basis": {
        "kind": "source-text",
        "paragraphId": 129714
      },
      "notes": []
    },
    {
      "id": "paragraph-129715-explanation",
      "revision": 1,
      "paragraphId": 129715,
      "sourceSha256": "3ec0faac379ff3255c822223ee13841ce8f6c527d4ef4de71dfa3ea85365a014",
      "sourceText": "魏敗趙師于懷。",
      "translation": "魏国军队在怀地打败赵军。",
      "reviewStatus": "unreviewed",
      "aiLabel": "AI生成·未经人工审校",
      "basis": {
        "kind": "source-text",
        "paragraphId": 129715
      },
      "notes": []
    },
    {
      "id": "paragraph-129716-explanation",
      "revision": 1,
      "paragraphId": 129716,
      "sourceSha256": "c26a73d77ed0da4b452d34c98f92bd6fdb02878afe1f382978e5c39f5faf87bd",
      "sourceText": "楚肅王薨，無子，立其弟良夫，是為宣王。",
      "translation": "楚肃王去世，没有儿子，于是拥立他的弟弟良夫，是为楚宣王。",
      "reviewStatus": "unreviewed",
      "aiLabel": "AI生成·未经人工审校",
      "basis": {
        "kind": "source-text",
        "paragraphId": 129716
      },
      "notes": [
        {
          "quote": "薨",
          "start": 3,
          "end": 4,
          "explanation": "古代对诸侯等去世的称谓。",
          "attribution": "本站AI拟释",
          "basis": {
            "kind": "source-text",
            "paragraphId": 129716
          }
        }
      ]
    },
    {
