      "revision": 1,
      "paragraphId": 129662,
      "sourceSha256": "4a1453f1353a21309fac828d625736515ffb2030f61ada0ad1929d730fdbaf6b",
      "sourceText": "齊伐魯，取最。〔韓救魯〕。",
      "translation": "齐国攻打鲁国，夺取最地。韩国援救鲁国。",
      "reviewStatus": "unreviewed",
      "aiLabel": "AI生成·未经人工审校",
      "basis": {
        "kind": "source-text",
        "paragraphId": 129662
      },
      "notes": []
    },
    {
