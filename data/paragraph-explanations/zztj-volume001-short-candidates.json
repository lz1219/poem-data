      "revision": 1,
      "paragraphId": 129656,
      "sourceSha256": "c40ace8025b7ad71cb3c3177d1d2b3b90b2bd89e8f864fc9921fb5db28870601",
      "sourceText": "王子定奔晉。",
      "translation": "王子定逃往晋国。",
      "reviewStatus": "unreviewed",
      "aiLabel": "AI生成·未经人工审校",
      "basis": {
        "kind": "source-text",
